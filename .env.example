# Set a long random value before deployment. This local default is only for trying Docker.
AUTH_SECRET=replace-with-a-long-random-secret
# PEM private key (newlines may be written as \\n). Generate an RSA key pair for production.
CUSTOMER_TOKEN_PRIVATE_KEY=
CUSTOMER_TOKEN_ISSUER=apexstore
# JSON map from high-entropy bearer secret to a name and exact scopes.
# For catalog indexing, configure the same random secret as APEXSTORE_CATALOG_API_TOKEN
# in the support assistant environment. Grant only needed scopes; the support assistant
# needs catalog:read and orders:read to fetch customer-owned records and verified email.
SHOP_API_KEYS={"replace-with-random-catalog-token":{"name":"support-assistant","scopes":["catalog:read","orders:read"]}}
# Provider HTTP refund endpoint and credential. Refunds fail closed until configured.
PAYMENT_REFUND_URL=
PAYMENT_API_KEY=
PAYMENT_TIMEOUT_MS=8000
REFUND_SYNC_SECRET=
NOVARETAIL_REFUND_SYNC_URL=http://host.docker.internal:8000/api/internal/v1/refunds/store-event
NOVARETAIL_REFUND_SYNC_SECRET=
REFUND_SYNC_TIMEOUT_MS=5000
# Local demo only. Requires NODE_ENV=development and a dedicated test credential.
ENABLE_TEST_REFUND_ENDPOINT=false
NODE_ENV=development
ADMIN_EMAILS=
# Local demo only: creates/verifies allowlisted staff accounts and sets their password.
# Leave blank outside a local demo. This option is disabled when NODE_ENV=production.
DEMO_ADMIN_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_NOVARETAIL_GATEWAY_URL=http://localhost:8000
NEXT_PUBLIC_NOVARETAIL_TENANT=tenant_novaretail

# Optional for local demo. Configure SMTP to enable email verification and password reset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
